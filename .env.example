# Optional build-time fallback for the daemon WebSocket URL.
NEXT_PUBLIC_WS_URL=

# Discord OAuth
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_ADMIN_IDS=1487343086198853785
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://hostgo.go-live.me

# Spotify (music module + optional panel login)
# Create app: https://developer.spotify.com/dashboard
# Redirect URI: https://hostgo.go-live.me/api/auth/callback/spotify
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Cloudflare Turnstile
# In Cloudflare Turnstile widget settings, add hostname: hostgo.go-live.me (and any other domains)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase (private secrets vault — service role NEVER expose to browser)
