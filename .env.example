# Optional build-time fallback for the daemon WebSocket URL.
NEXT_PUBLIC_WS_URL=

# Discord OAuth login (Vercel panel)
# Callback URL to add in Discord Developer Portal → OAuth2 → Redirects:
#   https://YOUR-PANEL.vercel.app/api/auth/callback
#   http://localhost:3000/api/auth/callback
NEXT_PUBLIC_DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Comma-separated Discord user IDs allowed to open the panel (your ID).
# Primary admin 1487343086198853785 is always allowed in code.
DISCORD_ADMIN_IDS=1487343086198853785
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://runner-six.vercel.app

# Cloudflare Turnstile (CAPTCHA on login page)
# https://dash.cloudflare.com/ → Turnstile → Add widget
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
