# Required: long random secret (>= 16 chars). The panel connects with ?token=<this>
AUTH_TOKEN=change-me-to-a-long-random-string

PORT=8080
# Keep 127.0.0.1 so only cloudflared (local) can reach the server
HOST=127.0.0.1

# Optional, comma separated browser origins allowed to connect, e.g. https://your-panel.vercel.app
ALLOWED_ORIGINS=

# Start the bot automatically when this server starts (useful after a PM2 resurrect)
AUTO_START=false

# Only used for the RAM bar in the panel (MB). Empty = total device memory. Not enforced.
RAM_LIMIT_MB=
