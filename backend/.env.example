# Required: long random secret (>= 16 chars). Panel connects with ?token=<this>
AUTH_TOKEN=change-me-to-a-long-random-string

PORT=8080

# --- Hosting mode ---
# Termux + Cloudflare Tunnel: keep HOST=127.0.0.1 (only local cloudflared reaches the daemon)
HOST=127.0.0.1

# Railway (or any public VPS): set HOST=0.0.0.0 so the public URL can reach WebSocket
# Railway also injects PORT automatically — do not hardcode PORT on Railway.
# HOST=0.0.0.0

# Optional, comma-separated browser origins allowed to connect, e.g. https://your-panel.vercel.app
ALLOWED_ORIGINS=

# Start the bot automatically when this server starts (useful after PM2 / Railway restart)
AUTO_START=false

# Only used for the RAM bar in the panel (MB). Empty = total device memory. Not enforced.
RAM_LIMIT_MB=
